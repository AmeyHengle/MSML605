# Groq API key — required for LLM-generated report summaries
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MLflow experiment name (optional — defaults to daily-intensity-pipeline)
MLFLOW_EXPERIMENT=daily-intensity-pipeline

# --- Slack Bot Configuration (Phase 4) ---
# Required: Create a Slack App at https://api.slack.com/apps
# Enable Socket Mode, add /ml605 slash command, enable Interactivity

# Bot User OAuth Token (xoxb-...) — found in OAuth & Permissions page
# Required scopes: chat:write, commands, files:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token (xapp-...) — found in Basic Information > App-Level Tokens
# Required scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Channel ID for pipeline alerts (e.g., C0123456789)
# Find via: right-click channel in Slack > View channel details > copy Channel ID
SLACK_CHANNEL_ID=C0123456789

# HITL timeout in minutes (default: 30)
# After this period with no Approve/Reject click, retrain is auto-rejected
SLACK_HITL_TIMEOUT_MINUTES=30
