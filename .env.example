# Groq API key — required for LLM-generated report summaries
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# MLflow experiment name (optional — defaults to daily-intensity-pipeline)
MLFLOW_EXPERIMENT=daily-intensity-pipeline

# MLflow tracking store. All runs AND the model registry live here.
# Keep this pinned to the project-local SQLite DB so every entry point
# (run_agent_pipeline.py, mlflow ui, CI) reads and writes the same store.
# For a remote tracking server, replace with e.g. http://mlflow.example.com
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Slack Bot Configuration (if using slack notifications) ---
# Required: Create a Slack App at https://api.slack.com/apps
# Enable Socket Mode, add /ml605 slash command, enable Interactivity

# Bot User OAuth Token (xoxb-...) — found in OAuth & Permissions page
# Required scopes: chat:write, commands, files:write
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token (xapp-...) — found in Basic Information > App-Level Tokens
# Required scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Channel ID for pipeline alerts (e.g., C0123456789)
# Find via: right-click channel in Slack > View channel details > copy Channel ID
SLACK_CHANNEL_ID=C0123456789

# HITL timeout in minutes (default: 30)
# After this period with no Approve/Reject click, retrain is auto-rejected
SLACK_HITL_TIMEOUT_MINUTES=30


# --- Unified runtime config ---
PIPELINE_WINDOW_HOURS=12
PIPELINE_INTERVAL_SECONDS=30
PIPELINE_KS_THRESHOLD=0.10
PIPELINE_PSI_THRESHOLD=0.25
MCP_BASE_URL=http://localhost:8001

# --- AWS Configuration (Pipeline A CloudWatch monitoring) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
APP_RUNNER_SERVICE_ARN=arn:aws:apprunner:us-east-1:123456789:service/msml605/your-service-id

# --- Canonical path contract ---
PROJECT_ROOT=.
DATA_DIR=data
WINDOWS_DIR=data/windows
REFERENCE_DATA_PATH=data/historical_data.csv
FEATURES_PATH=features_used.txt
